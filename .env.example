# ==============================================================================
# Technula EduFlow (SchoolOS) — Template Environment Configuration (.env.example)
# Copy this file to .env and replace placeholders with your actual values.
# ==============================================================================

# ── Application
PROJECT_NAME="Technula EduFlow"
FRONTEND_URL=http://localhost:5173

# ── Primary Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///academics_insights.db
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/insights_db

# ── Document Store (MongoDB Local or MongoDB Atlas for AI audit & logs)
MONGO_URL=mongodb://localhost:27017
# MONGO_URL=mongodb+srv://<db_user>:<db_password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=insights_ai

# ── JWT Authentication
JWT_SECRET_KEY=change-this-in-production-super-secret-key-2026-enterprise
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Google Gemini AI (Multimodal AI Insights & Weekly Briefings)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Meta WhatsApp Cloud API (Automated Parent Alerts & Notices)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# ── Transactional Email (Resend API)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=classes@mail.technula.com
RESEND_FROM_NAME=Technula Team
RESEND_API_URL=https://api.resend.com
RESEND_TIMEOUT_SECONDS=20
EMAIL_FROM=Technula Team <classes@mail.technula.com>

# ── Mobile Push Notifications (Firebase Cloud Messaging - FCM)
FIREBASE_CREDENTIALS_JSON=./firebase-service-account.json

# ── Multi-Tenant Payment Gateway & Encryption (School Fee Credentials)
PAYMENT_ENCRYPTION_KEY=school-os-aes256-secret-encryption-key-32b!

# ── PayU India (SaaS Platform Subscriptions)
PAYU_ENV=test
PAYU_KEY=your_payu_merchant_key
PAYU_SALT=your_payu_merchant_salt
PAYU_SUCCESS_URL=https://insights.agpkacademy.in/api/subscription/payu-callback/success
PAYU_FAIL_URL=https://insights.agpkacademy.in/api/subscription/payu-callback/fail

# ── DLT SMS Gateway (MetaReach SMS)
SMS_API_URL=https://sms.metareach.in/vb/apikey.php
METAREACH_API_KEY=your_metareach_api_key
METAREACH_SENDER_ID=AGPKAC
METAREACH_TEMPLATE_ID=1707177071739047190
SMS_PE_ID=
SMS_TE_ID=1707177071739047190

# ── Cloudflare R2 / AWS S3 Storage
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
AWS_REGION=auto
R2_PUBLIC_URL_PREFIX=

# ── SuperAdmin SaaS Config (Comma-separated 10-digit mobile numbers)
SUPERADMIN_PHONES=9999999999

# ── CORS Origins (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8081","https://insights.agpkacademy.in"]
