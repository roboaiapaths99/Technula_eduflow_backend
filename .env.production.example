# ==============================================================================
# Technula EduFlow — Master Production Configuration (.env)
# Domain: eduflow.technula.com
# ==============================================================================

# ── 1. POSTGRESQL PRODUCTION DATABASE
POSTGRES_USER=technula_admin
POSTGRES_PASSWORD=StrongDbPassword2026!EduFlow
POSTGRES_DB=eduflow_db
DATABASE_URL=postgresql://technula_admin:StrongDbPassword2026!EduFlow@db:5432/eduflow_db

# ── 2. SECURITY & AUTHENTICATION
# Generate a random 64-char key using: openssl rand -hex 32
JWT_SECRET_KEY=generate_a_64_character_random_hex_string_here_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ── 3. DOMAIN & CORS CONFIGURATION
FRONTEND_URL=https://eduflow.technula.com
CORS_ORIGINS=["https://eduflow.technula.com","https://technulaeduflow.technula.com","http://localhost:5173","*"]

# ── 4. GOOGLE GEMINI AI
# Powers student academic diagnosis, report card executive remarks, and Principal weekly pulse.
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── 5. TRANSACTIONAL EMAIL (RESEND)
# Used for report card PDFs, fee receipts, password resets, and announcements.
# Setup: https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=classes@mail.technula.com
RESEND_FROM_NAME=Technula EduFlow
EMAIL_FROM=Technula EduFlow <classes@mail.technula.com>

# ── 6. FIREBASE CLOUD MESSAGING (MOBILE PUSH NOTIFICATIONS)
# Path to your Firebase service account JSON file on the VPS
FIREBASE_CREDENTIALS_JSON=/app/firebase-service-account.json

# ── 7. META WHATSAPP CLOUD API (OPTIONAL)
# Direct WhatsApp updates to parents
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# ── 8. DLT SMS GATEWAY (INDIA DLT)
METAREACH_API_KEY=
METAREACH_SENDER_ID=EDUTEC
METAREACH_TEMPLATE_ID=
SMS_API_URL=https://sms.metareach.in/vb/apikey.php

# ── 9. MULTI-TENANT FEE COLLECTION (RAZORPAY)
PAYMENT_ENCRYPTION_KEY=school-os-aes256-secret-encryption-key-32b!
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── 10. SAAS SUBSCRIPTIONS (PAYU INDIA)
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENV=live
PAYU_SUCCESS_URL=https://eduflow.technula.com/api/subscription/payu-callback/success
PAYU_FAIL_URL=https://eduflow.technula.com/api/subscription/payu-callback/fail

# ── 11. CLOUD STORAGE (CLOUDFLARE R2 OR AWS S3)
# For student documents, report card PDFs, homework attachments
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
AWS_REGION=auto
R2_PUBLIC_URL_PREFIX=

# ── 12. SUPERADMIN ACCESS
# Comma-separated phone numbers with country code or 10-digit mobile
SUPERADMIN_PHONES=9876543210
